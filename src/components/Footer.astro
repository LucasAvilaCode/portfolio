---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="logo">
      <i class="fa-solid fa-code"></i>
      <span>Lucas</span>Avila
    </div>
    <p class="footer-text">
      © {new Date().getFullYear()} {site.fullName}. Todos los derechos reservados. Técnico Universitario en Programación Web (UNSJ).
    </p>
    <div class="social-links">
      <a href={site.github} target="_blank" rel="noopener" class="social-icon" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
      <a href={site.linkedin} target="_blank" rel="noopener" class="social-icon" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
      <a href={`mailto:${site.email}`} class="social-icon" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
    </div>
  </div>
</footer>
